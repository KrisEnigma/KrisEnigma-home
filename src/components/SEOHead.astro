---
import { getAllLanguagePaths, getLangFromUrl } from '../i18n/utils';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "profile";
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: any;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  image = "https://krisenigma.com/krisenigma.png",
  imageAlt = "KrisEnigma",
  type = "website",
  author = "KrisEnigma",
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const siteName = "KrisEnigma";
const baseUrl = "https://krisenigma.com";
const langPaths = getAllLanguagePaths(Astro.url.pathname, lang);

const defaultJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "KrisEnigma",
  alternateName: ['Kris Escobar'],
  description: lang === 'en' ? "Musician, Gamer and Content Creator" : "Músico, Gamer y Creador de Contenido",
  url: baseUrl,
  image,
  sameAs: [
    "https://youtube.com/KrisEnigma",
    "https://instagram.com/KrisEnigma",
    "https://tiktok.com/@KrisEnigma",
    "https://x.com/KrisEnigma",
    "https://twitch.tv/KrisEnigma",
    "https://open.spotify.com/artist/58QiArKYlCuEDMRBimZ48G",
    "https://github.com/KrisEnigma",
    "https://linkedin.com/in/krisescobar",
  ],
};

const structuredData = jsonLd || defaultJsonLd;
---

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<link rel="canonical" href={canonical} />

<!-- Hreflang -->
{langPaths.map(({ lang: l, path }) => (
  <link rel="alternate" hreflang={l} href={`${baseUrl}${path}`} />
))}
<link rel="alternate" hreflang="x-default" href={`${baseUrl}${langPaths.find(p => p.lang === 'es')?.path ?? '/'}`} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
<meta property="og:locale:alternate" content={lang === 'en' ? 'es_ES' : 'en_US'} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonical} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />
<meta property="twitter:image:alt" content={imageAlt} />
<meta property="twitter:site" content="@KrisEnigma" />
<meta property="twitter:creator" content="@KrisEnigma" />

{type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{type === "article" && author && <meta property="article:author" content={author} />}

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow" />
<meta name="format-detection" content="telephone=no" />
