---
import { getLangFromUrl, getAlternatePath, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alternatePath = getAlternatePath(lang, Astro.url.pathname);
const alternateLang = lang === 'es' ? 'en' : 'es';
---

<a
  href={alternatePath}
  class="lang-toggle"
  aria-label={t('lang.toggle.aria')}
  title={t('lang.toggle.aria')}
  data-lang={alternateLang}
  onclick={`localStorage.setItem('ke-lang', '${alternateLang}'); if(typeof gtag !== 'undefined') gtag('event', 'lang_toggle', { event_category: 'Navigation', event_label: '${alternateLang}' });`}
>
  {t('lang.toggle')}
</a>

<style>
  .lang-toggle {
    font-family: 'Titillium Web', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.34);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    padding: 4px 10px;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s, box-shadow 0.2s;
    backdrop-filter: blur(4px);
    background: rgba(0,0,0,0.2);
  }
  .lang-toggle:hover {
    color: #00e1af;
    border-color: rgba(0,225,175,0.25);
    background: rgba(0,225,175,0.08);
    box-shadow: 0 0 18px rgba(0,225,175,0.12);
  }
</style>
