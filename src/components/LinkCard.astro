---
import { Image } from 'astro:assets';

export interface Props {
  href?: string;
  image: string;
  title: string;
  description?: string; // Añadir description como opcional
  isNew?: boolean; // Añadir isNew como opcional
  onClick?: string;
  loading?: 'eager' | 'lazy'; // Controlar el lazy loading de la imagen
}

const { href, image, title, description, isNew = false, onClick, loading = 'lazy' } = Astro.props;
const commonClasses = "group relative grid grid-cols-9 items-center rounded-xl w-full glass-bg border border-white/20 text-white px-4 min-h-[3rem] hover:border-white/30 transform hover:scale-[1.01] link-item overflow-hidden transition-all duration-200 ease-out";
---

{href ? (  
  <a 
    href={href}
    target="_blank"
    rel="noopener noreferrer"    
    class={commonClasses}
  >
    <!-- Efecto de hover simple -->
    <div class="absolute inset-0 bg-gradient-to-r from-theme-primary/5 to-theme-accent/5 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
    
    {image && (
      <div class="h-8 w-8 col-span-1 justify-self-center relative z-10">
        <Image src={image} alt={`${title} logo`} class="h-full w-full object-contain my-auto transition-transform duration-200 group-hover:scale-105" width={32} height={32} loading={loading} />
      </div>    )}    <div class:list={[
      "text-center flex-1 px-2 relative z-10", 
      image ? "col-span-7" : "col-span-9"    ]}>
      <p class="font-uni-neue italic text-md leading-5 text-white group-hover:text-theme-primary transition-colors duration-200">{title}</p>
      {description && <p class="text-xs text-white opacity-80">{description}</p>}
    </div>
    {isNew && (
      <div class="absolute -top-1 -right-1 rounded-full bg-theme-primary/90 py-1 px-3 text-xs font-semibold uppercase text-white shadow-md">
        New
      </div>
    )}
  </a>
) : (  
  <button 
    type="button"
    onclick={onClick === "openContact" ? "window.openContact()" : onClick}
    class={commonClasses}
  >
    <!-- Efecto de hover simple -->
    <div class="absolute inset-0 bg-gradient-to-r from-theme-primary/5 to-theme-accent/5 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
    
    {image && (
      <div class="h-8 w-8 col-span-1 justify-self-center relative z-10">
        <Image src={image} alt={`${title} logo`} class="h-full w-full object-contain my-auto transition-transform duration-200 group-hover:scale-105" width={32} height={32} loading={loading} />
      </div>
    )}    <div class:list={[      "text-center flex-1 px-2 relative z-10", 
      image ? "col-span-7" : "col-span-9"    ]}>
      <p class="font-uni-neue italic text-md leading-5 text-white group-hover:text-theme-primary transition-colors duration-200">{title}</p>
      {description && <p class="text-xs text-white opacity-80">{description}</p>}    </div>
    {isNew && (
      <div class="absolute -top-1 -right-1 rounded-full bg-theme-primary/90 py-1 px-3 text-xs font-semibold uppercase text-white shadow-md">
        New
      </div>
    )}
  </button>
)}

