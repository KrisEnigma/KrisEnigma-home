---
// ProjectModal.astro - Modal para mostrar información de proyectos
---

<!-- Modal de Proyecto -->
<div
  id="projectModal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300"
>
  <!-- Contenedor del modal -->
  <div
    class="relative mx-4 w-full max-w-2xl bg-gray-900/95 backdrop-blur-lg rounded-xl border border-white/20 shadow-2xl transform scale-95 transition-all duration-300 max-h-[90vh] overflow-y-auto"
  >
    <!-- Header del modal -->
    <div
      class="flex items-center justify-between p-6 border-b border-white/10 sticky top-0 bg-gray-900/95 backdrop-blur-lg"
    >
      <div class="flex items-center space-x-3">
        <span id="projectIcon" class="text-2xl"></span>
        <h3 id="projectTitle" class="text-xl text-white font-uni-neue italic">
        </h3>
      </div>
      <button
        id="closeProjectModal"
        class="p-2 rounded-lg bg-red-500/20 hover:bg-red-500/30 text-red-400 hover:text-red-300 transition-all duration-200 border border-red-500/30 hover:border-red-400/50"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Contenido del modal -->
    <div class="p-6">
      <!-- Imagen del proyecto -->
      <div class="mb-6 overflow-hidden rounded-lg">
        <img
          id="projectImage"
          src=""
          alt=""
          class="w-full h-48 object-cover transition-all duration-300 ease-out hover:scale-105"
        />
      </div>

      <!-- Descripción del proyecto -->
      <div
        id="projectDescription"
        class="text-white leading-relaxed space-y-4 mb-6"
      >
        <!-- El contenido se cargará dinámicamente -->
      </div>
      <!-- Información adicional -->
      <div id="projectDetails" class="space-y-3 mb-6">
        <!-- Los detalles se cargarán dinámicamente -->
      </div>

      <!-- Tecnologías utilizadas -->
      <div id="projectTechnologies" class="mb-6">
        <!-- Las tecnologías se cargarán dinámicamente -->
      </div>

      <!-- Botones de acción -->
      <div class="flex flex-col sm:flex-row gap-3">
        <button
          id="visitProject"
          class="flex-1 px-6 py-3 bg-theme-accent hover:bg-theme-accent/80 text-white font-uni-neue italic rounded-lg font-medium transition-all duration-200 hover:scale-[1.02]"
        >
          Visitar Proyecto
        </button>
        <button
          id="closeProjectModalBottom"
          class="px-6 py-3 bg-white/10 hover:bg-white/20 text-white font-uni-neue italic rounded-lg font-medium transition-all duration-200 border border-white/20"
        >
          Cerrar
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // Solo declarar projectsData y funciones si no existen en window
  if (!window.__krisProjectsModalLoaded) {
    window.__krisProjectsModalLoaded = true;
    // Datos de los proyectos
    const projectsData = {
      "tercer-ojo": {
        title: "Tercer Ojo - El Juego",
        icon: "👁️",
        image: "https://tercerojo.net/logo3erojo.jpg",
        description: [
          'Tercer Ojo es mi <strong>proyecto más querido y duradero</strong>: un <strong>juego web de enigmas</strong> que creé en septiembre de <strong>2006</strong> y que <strong>sigue activo hasta hoy</strong>. Lo que comenzó como un experimento se convirtió en <strong>"el juego de acertijos en línea más difícil en español"</strong>, manteniendo una <strong>comunidad dedicada</strong> durante casi <strong>dos décadas</strong>.',
          "El juego desafía a los jugadores con más de <strong>100 niveles</strong> de <strong>puzzles únicos</strong> que van desde <strong>criptografía básica</strong> hasta <strong>complejos rompecabezas</strong> que requieren conocimiento de <strong>programación, música, historia, matemáticas y cultura general</strong>. Cada nivel es una <strong>experiencia única</strong>: algunos requieren analizar <strong>espectrogramas de audio</strong>, otros <strong>descifrar códigos</strong> o resolver <strong>sudokus temáticos</strong>.",
          "A lo largo de los años he <strong>modernizado completamente</strong> el juego: partió como simple <strong>HTML y CSS</strong> escrito a mano en <strong>Notepad en 2006</strong>, y ahora cuenta con <strong>autenticación Firebase</strong> para guardar progreso, <strong>sistema de ranking</strong>, <strong>vibración háptica</strong> en móviles, <strong>modo PWA</strong>, y un <strong>foro oficial</strong> donde la comunidad comparte pistas. Aunque no agrego niveles nuevos ni contenido adicional, me aseguro de que el juego y el foro <strong>sigan funcionando perfectamente</strong> y mantenga su <strong>esencia original</strong> con los más de <strong>100 puzzles</strong> que diseñé.",
          "Lo que más me emociona de Tercer Ojo no son solo los enigmas que diseño, sino la <strong>comunidad que se formó alrededor</strong>. Ver a personas de <strong>diferentes países colaborando</strong> para resolver puzzles que creé hace años es una de las <strong>experiencias más gratificantes</strong> de mi carrera como creador de contenido.",
        ],
        details: [
          { label: "Año de creación", value: "2006 (activo 18+ años)" },
          { label: "Tipo", value: "Juego de enigmas web multidisciplinario" },
          { label: "Niveles", value: "100+ puzzles únicos" },
          { label: "Estado", value: "Activo y mantenido regularmente" },
          {
            label: "Comunidad",
            value: "Fanbase internacional con foro oficial",
          },
          {
            label: "Características",
            value: "PWA, ranking, autenticación, modo offline",
          },
        ],
        technologies:
          "Desarrollado con <strong>JavaScript ES6+</strong> y <strong>TypeScript</strong> para tipado estático y mejor mantenibilidad. Frontend construido con <strong>HTML5</strong> y <strong>CSS3 moderno</strong>. Backend utiliza <strong>Firebase 10.3.1</strong> (<strong>Authentication, Realtime Database, Storage, Functions</strong>). Implementa <strong>Service Workers</strong> para <strong>PWA</strong> y funcionalidad <strong>offline</strong>. Bibliotecas especializadas incluyen <strong>Highlight.js 11.11.1</strong> para sintaxis de código, <strong>Font Awesome</strong> para iconografía, y <strong>Firebase UI</strong> para autenticación. Incluye detección avanzada de <strong>dispositivos móviles</strong>, optimizaciones <strong>touch</strong>, y sistema de <strong>vibración háptica</strong>.",
        url: "https://tercerojo.net",
      },
      "psycho-crusher": {
        title: "Psycho Crusher",
        icon: "🎸",
        image: "https://psycho-crusher.com/files/header.jpg",
        description: [
          "Psycho Crusher es mi <strong>proyecto musical más personal y duradero</strong>. Desde <strong>2010</strong> he estado transformando los <strong>soundtracks más memorables</strong> de los videojuegos en versiones <strong>rock y metal</strong>, combinando mi amor por la música con mi pasión por el gaming.",
          'A lo largo de estos años he lanzado <strong>dos álbumes</strong>: <strong>"Psycho Crusher" (2013)</strong> y <strong>"Avocado Overdose" (2015)</strong>, más el single <strong>"MaxX Unlimited" (2023)</strong>. Mi cover de <strong>"Still Alive"</strong> de <strong>Mirror\'s Edge</strong> se ha convertido en el <strong>track más escuchado</strong> con más de <strong>527,000 reproducciones</strong> en <strong>Spotify</strong>, lo cual nunca imaginé cuando lo grabé.',
          "He tenido la oportunidad de llevar estas versiones a <strong>eventos importantes</strong> de la escena gamer chilena como <strong>Festigame</strong> y <strong>Minami Convention</strong>. Ver a la gente <strong>cantando y headbangeando</strong> temas de <strong>Undertale, Contra o Wolfenstein</strong> en versión rock es una experiencia <strong>indescriptible</strong>.",
          "Lo que más me satisface es que Psycho Crusher ha encontrado su <strong>propia identidad</strong>: no solo adapto la música, sino que la <strong>reimagino completamente</strong>. Cada cover respeta la <strong>esencia original</strong> pero añade esa <strong>intensidad del rock</strong> que caracteriza mi estilo. Con más de <strong>8,300 oyentes mensuales</strong> en Spotify, puedo decir que he logrado crear algo <strong>genuino en el mundo del VGM</strong>.",
        ],
        details: [
          { label: "Artista", value: 'Kris Escobar' },
          { label: "Año de inicio", value: "2010" },
          { label: "Género", value: "VGM Rock/Metal" },
          {
            label: "Álbumes",
            value: "2 álbumes + 1 single (2013, 2015, 2023)",
          },
          { label: "Oyentes mensuales", value: "8,300+ en Spotify" },
          {
            label: "Hit más popular",
            value: '"Still Alive" - 527K reproducciones',
          },
          {
            label: "Presentaciones",
            value: "Festigame, Minami Convention y más",
          },
          {
            label: "Plataformas",
            value: "Todas las principales (Spotify, Apple, etc.)",
          },
        ],
        technologies:
          "Producción musical realizada con <strong>DAW profesional</strong> para grabación <strong>multi-pista</strong>. <strong>Masterización digital</strong> y distribución a <strong>plataformas de streaming</strong> mediante <strong>DistroKid</strong>. Sitio web oficial desarrollado con tecnologías web estándar (<strong>HTML5, CSS3, JavaScript</strong>) para promoción y contenido multimedia. Uso de herramientas de <strong>audio profesionales</strong> para grabación de <strong>guitarra eléctrica</strong>, <strong>bajo</strong> y <strong>batería programada</strong>, con procesamiento de <strong>efectos</strong> y <strong>plugins especializados</strong> para el género <strong>rock/metal</strong>.",
        url: "http://psycho-crusher.com/",
      },
      gamelist: {
        title: "GameList",
        icon: "🎮",
        image: "/gamelist.jpg",
        description: [
          "GameList nació de mi <strong>necesidad obsesiva</strong> de llevar registro de <strong>todos los juegos que completo</strong>. Como alguien que lleva más de <strong>30 años jugando</strong>, desde mis primeros días con <strong>Atari</strong> hasta los <strong>títulos modernos</strong>, sentía que estaba perdiendo de vista mi <strong>propio historial gaming</strong>.",
          "Lo que comenzó como una <strong>simple lista en Excel</strong> evolucionó hacia esta <strong>aplicación web</strong> donde documento <strong>cada juego que termino</strong>, incluyendo mi <strong>calificación personal</strong>, <strong>tiempo jugado</strong>, <strong>plataforma</strong> y <strong>reflexiones sobre la experiencia</strong>. Es mi <strong>archivo personal</strong>, pero decidí hacerlo <strong>público</strong> porque creo que puede ser útil para otros gamers.",
          "He documentado más de <strong>900 juegos completados</strong>, desde <strong>indies que nadie conoce</strong> hasta los <strong>AAA más populares</strong>. No todos tienen reseña completa todavía - estoy en el proceso de agregar <strong>calificaciones a todos</strong> y <strong>micro-reseñas</strong> cuando sea posible, incluyendo <strong>links a streams</strong> donde los jugué en vivo.",
          "Es un <strong>proyecto muy personal</strong> que uso constantemente. Me ayuda a <strong>recordar qué pensaba</strong> de ciertos juegos, a <strong>redescubrir títulos</strong> que había olvidado, y a mantener un <strong>registro tangible</strong> de <strong>décadas de gaming</strong>. Para mí, es tan valiosa como una <strong>biblioteca personal de libros</strong>.",
        ],
        details: [
          { label: "Juegos documentados", value: "900+" },
          { label: "Período personal", value: "30+ años de gaming" },
          { label: "Desde", value: "Atari hasta actualidad" },
          {
            label: "Contenido",
            value: "Calificaciones y micro-reseñas en progreso",
          },
          { label: "Propósito", value: "Archivo personal público" },
          { label: "Actualización", value: "Cada juego completado" },
          { label: "Valor", value: "Registro histórico personal" },
        ],
        technologies:
          "Construida con <strong>Next.js 14</strong> y <strong>React 18</strong> para el frontend moderno. <strong>TypeScript</strong> para tipado estático y mejor desarrollo. Utiliza <strong>Tailwind CSS</strong> con <strong>PostCSS</strong> para estilos optimizados. Backend potenciado por <strong>Supabase</strong> con base de datos <strong>PostgreSQL</strong>. Integra múltiples <strong>APIs externas</strong>: <strong>IGDB</strong> para metadatos de juegos, <strong>Steam API</strong>, y <strong>SteamGridDB</strong> para imágenes. Sistema de <strong>autenticación completo</strong>, <strong>hooks personalizados</strong> para gestión de estado, y <strong>componentes reutilizables</strong>. Configuración con <strong>ESLint</strong> y arquitectura de <strong>servicios modulares</strong>.",
        url: "https://krisenigma.com/gamelist",
      },
      gamesalad: {
        title: "GameSalad",
        icon: "🎯",
        image: "/gamesalad.jpg",
        description: [
          'GameSalad es mi <strong>experimento personal</strong> con los <strong>juegos de palabras</strong>, inspirado en el concepto <strong>"Word Salad"</strong>. Decidí crear mi <strong>propia versión</strong> como un <strong>ejercicio de programación</strong> y <strong>diseño de juegos</strong>, combinando mi pasión por el <strong>desarrollo web</strong> con la mecánica <strong>simple pero adictiva</strong> de encontrar palabras.',
          "Lo desarrollé usando <strong>tecnologías web modernas</strong>, enfocándome especialmente en hacer que funcionara bien tanto en <strong>escritorio</strong> como <strong>móviles</strong>. Implementé funciones como <strong>vibración háptica</strong> para dispositivos móviles y un <strong>sistema PWA</strong> para que se pueda <strong>instalar como una app nativa</strong>.",
          "El proyecto me sirvió para experimentar con <strong>Capacitor</strong>, <strong>Service Workers</strong> y <strong>arquitecturas modulares</strong> en JavaScript. Aunque es un <strong>concepto simple</strong>, me permitió explorar muchas <strong>tecnologías interesantes</strong> y practicar el <strong>desarrollo de juegos casuales</strong>.",
          "Es uno de esos proyectos que nació de mi <strong>curiosidad</strong> por ver cómo funcionan internamente este tipo de juegos y mi deseo de <strong>implementar mi propia versión desde cero</strong>. No busca <strong>revolucionar el género</strong>, sino ser un <strong>ejemplo sólido</strong> de <strong>desarrollo web moderno</strong> aplicado a <strong>gaming casual</strong>.",
        ],
        details: [
          { label: "Tipo", value: "Juego de palabras experimental" },
          { label: "Inspiración", value: "Word Salad (implementación propia)" },
          { label: "Propósito", value: "Experimento de desarrollo web" },
          { label: "Características", value: "PWA, vibración háptica" },
          { label: "Enfoque", value: "Aprendizaje de tecnologías" },
          { label: "Estado", value: "Prototipo funcional" },
          { label: "Objetivo", value: "Práctica de desarrollo de juegos" },
        ],
        technologies:
          "Desarrollado con <strong>JavaScript ES6+</strong> y <strong>arquitectura modular</strong> usando servicios (<strong>ElementService, ConfigurationService</strong>). Implementa <strong>Capacitor</strong> para funcionalidades nativas móviles como <strong>vibración háptica</strong>, <strong>notificaciones locales</strong> y <strong>gestión de estado</strong> de aplicación. Build system configurado con <strong>Vite</strong> para desarrollo rápido y <strong>HTTPS local</strong>. Incluye <strong>Service Workers</strong> para funcionalidad <strong>PWA</strong>, <strong>Stylelint</strong> para calidad <strong>CSS</strong>, y <strong>ESLint</strong> con <strong>SonarJS</strong> para análisis de código. Sistema de <strong>almacenamiento persistente</strong> con <strong>Capacitor Preferences</strong>.",
        url: "https://gamesalad.krisenigma.com",
      },
    }; // Función para abrir el modal del proyecto
    function openProjectModal(projectId) {
      const modal = document.getElementById("projectModal");
      const project = projectsData[projectId];

      if (!modal || !project) return;

      // Actualizar contenido del modal
      const title = document.getElementById("projectTitle");
      const icon = document.getElementById("projectIcon");
      const image = document.getElementById("projectImage");
      const description = document.getElementById("projectDescription");
      const details = document.getElementById("projectDetails");
      const visitButton = document.getElementById("visitProject");
      if (title) title.textContent = project.title;
      if (icon) icon.textContent = project.icon;
      if (image) {
        // Ocultar imagen y limpiar src anterior para evitar flashes
        image.style.opacity = "0";
        image.src = "";
        image.alt = "";

        // Crear nueva imagen para precargar
        const newImage = new Image();
        newImage.onload = () => {
          // Solo actualizar si seguimos en el mismo proyecto
          if (image.alt !== project.title) {
            image.src = project.image;
            image.alt = project.title;
            image.style.opacity = "1";
          }
        };

        // Manejar errores de carga
        newImage.onerror = () => {
          image.src = "";
          image.alt = project.title;
          image.style.opacity = "0";
        };

        // Iniciar precarga
        newImage.src = project.image;
      }
      if (description) {
        description.innerHTML = project.description
          .map((p) => `<p class="text-base text-white">${p}</p>`)
          .join("");
      }
      if (details) {
        details.innerHTML = project.details
          .map(
            (detail) => `
          <div class="flex justify-between items-center py-2 border-b border-white/10 last:border-b-0">
            <span class="text-white/70 text-sm font-uni-neue italic">${detail.label}:</span>
            <span class="text-white font-medium text-sm">${detail.value}</span>
          </div>
        `
          )
          .join("");
      }

      // Mostrar tecnologías si existen
      const technologiesContainer = document.getElementById(
        "projectTechnologies"
      );
      if (technologiesContainer && project.technologies) {
        technologiesContainer.innerHTML = `
        <div class="bg-white/5 rounded-lg p-4 border border-white/10">
          <h4 class="text-white font-medium font-uni-neue italic mb-2 text-sm flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            Tecnologías
          </h4>
          <p class="text-white/80 text-sm leading-relaxed">${project.technologies}</p>
        </div>
      `;
      } else if (technologiesContainer) {
        technologiesContainer.innerHTML = "";
      }

      if (visitButton) {
        visitButton.onclick = () => window.open(project.url, "_blank");
      } // Resetear scroll del contenido del modal
      const modalContent = modal.querySelector(".overflow-y-auto");
      if (modalContent) {
        modalContent.scrollTop = 0;
      }

      // Mostrar modal y evitar scroll del body
      modal.classList.remove("opacity-0", "pointer-events-none");
      modal.querySelector(".transform")?.classList.remove("scale-95");
      modal.querySelector(".transform")?.classList.add("scale-100");
      document.body.style.overflow = "hidden";
    }

    // Función para cerrar el modal
    function closeProjectModal() {
      const modal = document.getElementById("projectModal");
      if (!modal) return;

      modal.classList.add("opacity-0", "pointer-events-none");
      modal.querySelector(".transform")?.classList.add("scale-95");
      modal.querySelector(".transform")?.classList.remove("scale-100");

      // Restaurar scroll del body después de la animación
      setTimeout(() => {
        document.body.style.overflow = "auto";
      }, 300);
    }

    // Event listeners
    document.addEventListener("DOMContentLoaded", () => {
      // Cerrar modal
      document
        .getElementById("closeProjectModal")
        ?.addEventListener("click", closeProjectModal);
      document
        .getElementById("closeProjectModalBottom")
        ?.addEventListener("click", closeProjectModal);

      // Cerrar modal al hacer clic en el fondo
      document
        .getElementById("projectModal")
        ?.addEventListener("click", (e) => {
          if (e.target === e.currentTarget) {
            closeProjectModal();
          }
        }); // Cerrar modal con Escape
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const modal = document.getElementById("projectModal");
          if (modal && !modal.classList.contains("pointer-events-none")) {
            closeProjectModal();
          }
        }
      });
    });
    // Hacer la función global para que pueda ser llamada desde otros scripts
    window.openProjectModal = openProjectModal;
  }
</script>
