---
// Componente para analytics y monitoreo de rendimiento
const { gtagId } = Astro.props;
---

<!-- Google Analytics 4 -->{
  gtagId && (
    <>
      {" "}
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`}
      />
      <script
        is:inline
        set:html={`
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '${gtagId}', {
        page_title: document.title,
        page_location: window.location.href,
      });
    `}
      />
    </>
  )
}

<!-- Performance Monitoring -->
<script is:inline set:html={`(function(){
  // Basic performance monitoring
  window.addEventListener("load", function(){
    try {
      var navigation = performance.getEntriesByType("navigation")[0];
      if (navigation) {
        var loadTime = (navigation.loadEventEnd || 0) - (navigation.loadEventStart || 0);
        console.log("Page Load Time:", loadTime + "ms");
        if (typeof window.gtag !== "undefined") {
          window.gtag("event", "page_load_time", {
            event_category: "Performance",
            value: Math.round(loadTime),
            non_interaction: true
          });
        }
      }
    } catch (e) {
      // ignore diagnostics/runtime gaps
    }
  });

  // Error tracking
  window.addEventListener("error", function(event){
    try {
      console.error("JavaScript Error:", {
        message: event.message,
        filename: event.filename,
        lineno: event.lineno,
        colno: event.colno,
        error: event.error
      });
      if (typeof window.gtag !== "undefined") {
        window.gtag("event", "exception", {
          description: event.message,
          fatal: false
        });
      }
    } catch (e) {}
  });

  window.addEventListener("unhandledrejection", function(event){
    try {
      console.error("Unhandled Promise Rejection:", event.reason);
      if (typeof window.gtag !== "undefined") {
        window.gtag("event", "exception", {
          description: "Unhandled Promise Rejection: " + event.reason,
          fatal: false
        });
      }
    } catch (e) {}
  });

  // CTA click tracking — fires for any element with data-track attribute
  document.addEventListener('click', function(e) {
    try {
      var el = e.target.closest('[data-track]');
      if (!el || typeof window.gtag === 'undefined') return;
      window.gtag('event', el.dataset.track, {
        event_category: 'CTA',
        event_label: el.dataset.label || el.textContent.trim().slice(0, 50),
        value: 1
      });
    } catch (e) {}
  });
})();
`}></script>
