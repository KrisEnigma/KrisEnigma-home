---
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'en' ? '/en' : '';

const layoutDesc = lang === 'en'
  ? "AI Support Specialist at ElevenLabs. Full-stack developer. Independent projects in production. Targeting AI Solutions Engineering roles."
  : "AI Support Specialist en ElevenLabs. Full-stack developer. Proyectos en producción. Apuntando a AI Solutions Engineering.";

const roleSinceLine = lang === 'en'
  ? `${t('pro.since')} · ~35 tickets/day · Full English environment`
  : `${t('pro.since')} · ~35 tickets/día · Inglés`;

const visitLabel = lang === 'en' ? 'Visit' : 'Visitar';

const crosslinkText = lang === 'en'
  ? "Curious about my creative side as KrisEnigma?"
  : "¿Curioso por mi lado creativo como KrisEnigma?";
const crosslinkArrow = lang === 'en'
  ? "View creative profile →"
  : "Ver perfil creativo →";

const projects = lang === 'en' ? [
  {
    emoji: "👁️",
    name: "Tercer Ojo",
    url: "https://tercerojo.net",
    years: "19",
    desc: "Web puzzle game with 100+ unique levels. Active international community since 2006.",
    tech: ["JavaScript", "TypeScript", "Firebase", "PWA", "Service Workers"],
    accent: "teal",
  },
  {
    emoji: "🎮",
    name: "Crónica",
    url: "https://cronica.krisenigma.com/",
    years: "2",
    desc: "Personal catalogue of 900+ completed games spanning 30+ years. Integrates IGDB, Steam API, and SteamGridDB.",
    tech: ["Next.js 14", "React 18", "TypeScript", "Supabase", "PostgreSQL", "Tailwind"],
    accent: "purple",
  },
  {
    emoji: "🤖",
    name: "Local AI RAG Stack",
    url: null,
    years: null,
    desc: "Fully local AI assistant with custom RAG pipeline indexed over structured documentation.",
    tech: ["Ollama", "Qwen3 14B", "Open WebUI", "RAG"],
    accent: "teal",
  },
  {
    emoji: "🌐",
    name: "krisenigma.com",
    url: "https://krisenigma.com",
    years: null,
    desc: "Personal site with CI/CD, Cloudflare Pages Functions, spam protection, and production-grade security headers.",
    tech: ["Astro", "TypeScript", "Tailwind", "Cloudflare Pages", "Resend", "GitHub Actions"],
    accent: "purple",
  },
  {
    emoji: "🖥️",
    name: "Home Server",
    url: null,
    years: null,
    desc: "Home-built mini server running Homepage, Home Assistant, Cockpit, PiHole, Plex, and qBittorrent. Mix of Docker and bare metal depending on what makes sense per service.",
    tech: ["Docker", "Home Assistant", "PiHole", "Linux", "Cockpit"],
    accent: "teal",
  },
  {
    emoji: "☁️",
    name: "Oracle Cloud VPS",
    url: null,
    years: null,
    desc: "Personal VPS on Oracle Cloud running Quake 3 servers, a RustDesk server for remote access, custom stream alert tools, and various other self-hosted services.",
    tech: ["Oracle Cloud", "Linux", "Docker", "RustDesk"],
    accent: "purple",
  },
] : [
  {
    emoji: "👁️",
    name: "Tercer Ojo",
    url: "https://tercerojo.net",
    years: "19",
    desc: "Juego web de enigmas con 100+ niveles únicos. Comunidad internacional activa desde 2006.",
    tech: ["JavaScript", "TypeScript", "Firebase", "PWA", "Service Workers"],
    accent: "teal",
  },
  {
    emoji: "🎮",
    name: "Crónica",
    url: "https://cronica.krisenigma.com/",
    years: "2",
    desc: "Catálogo personal de 900+ juegos completados. Integra IGDB, Steam API y SteamGridDB.",
    tech: ["Next.js 14", "React 18", "TypeScript", "Supabase", "PostgreSQL", "Tailwind"],
    accent: "purple",
  },
  {
    emoji: "🤖",
    name: "Local AI RAG Stack",
    url: null,
    years: null,
    desc: "Asistente IA local con pipeline RAG propio indexado sobre documentación estructurada.",
    tech: ["Ollama", "Qwen3 14B", "Open WebUI", "RAG"],
    accent: "teal",
  },
  {
    emoji: "🌐",
    name: "krisenigma.com",
    url: "https://krisenigma.com",
    years: null,
    desc: "Sitio personal con CI/CD, Cloudflare Pages Functions, anti-spam, seguridad HTTP headers.",
    tech: ["Astro", "TypeScript", "Tailwind", "Cloudflare Pages", "Resend", "GitHub Actions"],
    accent: "purple",
  },
  {
    emoji: "🖥️",
    name: "Home Server",
    url: null,
    years: null,
    desc: "Minibox casero con Homepage, Home Assistant, Cockpit, PiHole, Plex y qBittorrent. Mix de Docker y bare metal según lo que tiene sentido para cada servicio.",
    tech: ["Docker", "Home Assistant", "PiHole", "Linux", "Cockpit"],
    accent: "teal",
  },
  {
    emoji: "☁️",
    name: "Oracle Cloud VPS",
    url: null,
    years: null,
    desc: "VPS personal en Oracle Cloud con servidores de Quake 3, servidor RustDesk para acceso remoto, herramientas de alertas de stream personalizadas, y varios servicios adicionales.",
    tech: ["Oracle Cloud", "Linux", "Docker", "RustDesk"],
    accent: "purple",
  },
