const stack = lang === 'en' ? [
  { label: "Languages & Frameworks", items: "Node.js · React · Next.js 14 · Astro · TypeScript · JavaScript ES6+ · HTML5/CSS3 · C# · Cloudflare Workers/D1" },
  { label: "Web Development", items: "Custom sites · WordPress · Responsive design · Deploy and maintenance · 20+ years of independent projects in production" },
  { label: "AI & LLMs", items: "Ollama · RAG pipeline · Open WebUI · ElevenLabs API · Claude · ChatGPT · Gemini" },
  { label: "Databases", items: "Supabase (PostgreSQL) · Firebase · Cloudflare D1 · MySQL" },
  { label: "Infrastructure", items: "Linux · Docker · Oracle Cloud VPS · Cloudflare Pages Functions · GitHub Actions · Vercel · Wrangler CLI" },
  { label: "Support & Ops", items: "Zendesk · Salesforce · Postman · Parahelp · Sigma · Posthog · Sendgrid · Asana" },
  { label: "Media & Broadcast", items: "OBS Studio · vMix · Streamlabs · StreamElements · Adobe Premiere · Audition · DaVinci Resolve" },
  { label: "Visual Design", items: "Brand identity · Stream overlays · Video graphics · Photoshop · DaVinci Resolve" },
] : [
  { label: "Lenguajes & Frameworks", items: "Node.js · React · Next.js 14 · Astro · TypeScript · JavaScript ES6+ · HTML5/CSS3 · C# · Cloudflare Workers/D1" },
  { label: "Desarrollo Web", items: "Sitios custom · WordPress · Diseño responsive · Deploy y mantenimiento · 20+ años de proyectos propios en producción" },
  { label: "AI & LLMs", items: "Ollama · RAG pipeline · Open WebUI · ElevenLabs API · Claude · ChatGPT · Gemini" },
  { label: "Bases de datos", items: "Supabase (PostgreSQL) · Firebase · Cloudflare D1 · MySQL" },
  { label: "Infraestructura", items: "Linux · Docker · Oracle Cloud VPS · Cloudflare Pages Functions · GitHub Actions · Vercel · Wrangler CLI" },
  { label: "Soporte & Ops", items: "Zendesk · Salesforce · Postman · Parahelp · Sigma · Posthog · Sendgrid · Asana" },
  { label: "Media & Broadcast", items: "OBS Studio · vMix · Streamlabs · StreamElements · Adobe Premiere · Audition · DaVinci Resolve" },
  { label: "Diseño Visual", items: "Brand identity · Stream overlays · Video graphics · Photoshop · DaVinci Resolve" },
];

const experience = lang === 'en' ? [
  {
    company: "GrupoZ",
    role: "Broadcast Software Developer & Video QA",
    period: "Oct 2022 – Dec 2023",
    desc: "QA of HD/SD broadcast streams for VTR (Chile). Independently designed and built an internal C# tool to automate bulk video format transformation using FFmpeg, FFprobe, and MediaInfo, replacing a cumbersome manual workflow.",
  },
  {
    company: "NexoPlay / Control.VG",
    role: "Scriptwriter, Presenter & Editor",
    period: "Jun 2018 – Oct 2022",
    desc: "Scriptwriter, on-screen presenter, video editor, and creative director for cable TV gaming channels and fan-driven media. Guest on IGN Latam. On-site press coverage at E3, Los Angeles, including live interviews with Reggie Fils-Aimé and Ed Boon.",
  },
  {
    company: "Freelance",
    role: "Streaming & Broadcast Technician",
    period: "2016 – 2024",
    desc: "Stream manager, director assistant, and broadcast producer for live events (concurrent, on-call). OBS Studio, vMix, Streamlabs, StreamElements; multi-camera setups and live encoding pipelines.",
  },
  {
    company: "Steam A Luca",
    role: "Manager & Customer Support Executive",
    period: "Nov 2012 – Jul 2016",
    desc: "Operated own digital goods storefront (Steam, PlayStation, Xbox). Full business management: payment processing, fraud prevention, and customer support.",
  },
  {
    company: "Groupon",
    role: "Customer Experience Manager",
    period: "Jun 2011 – Oct 2012",
    desc: "Handled customer interactions via email, phone, and social media for the global e-commerce marketplace.",
  },
] : [
  {
    company: "GrupoZ",
    role: "Broadcast Software Developer & Video QA",
    period: "Oct 2022 – Dic 2023",
    desc: "QA de streams HD/SD para VTR (Chile). Diseñé y construí una herramienta interna en C# (por iniciativa propia) para automatizar transformación masiva de video con FFmpeg, FFprobe y MediaInfo, reemplazando un flujo manual.",
  },
  {
    company: "NexoPlay / Control.VG",
    role: "Guionista, Presentador & Editor",
    period: "Jun 2018 – Oct 2022",
    desc: "Guionista, presentador en cámara, editor y dirección creativa para canales de cable y medios de gaming. Invitado en IGN Latam. Cobertura de prensa en E3, Los Ángeles, con entrevistas a Reggie Fils-Aimé y Ed Boon.",
  },
  {
    company: "Freelance",
    role: "Técnico de Streaming & Broadcast",
    period: "2016 – 2024",
    desc: "Stream manager, director asistente y productor de broadcast para eventos en vivo (concurrent). OBS Studio, vMix, Streamlabs, StreamElements; pipelines de encoding multi-cámara.",
  },
  {
    company: "Steam A Luca",
    role: "Manager & Customer Support Executive",
    period: "Nov 2012 – Jul 2016",
    desc: "Tienda propia de contenido digital (Steam, PlayStation, Xbox). Gestión de negocio completa: pagos, prevención de fraude y soporte al cliente.",
  },
  {
    company: "Groupon",
    role: "Customer Experience Manager",
    period: "Jun 2011 – Oct 2012",
    desc: "Atención al cliente vía email, teléfono y redes sociales para el marketplace global.",
  },
];
---

<Layout title="Kris Escobar | AI Solutions & Full-Stack Developer" description={layoutDesc}>
  <div class="pro-page">
    <div class="page-glow-pro"></div>
    <!-- Back nav -->
    <div class="back-nav">
      <a href={`${prefix}/`} class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        {t('nav.back')}
      </a>
      <a href={`${prefix}/contact`} class="back-link nav-contact-pill">{t('nav.contact')}</a>
    </div>

    <div class="pro-inner">
      <!-- Hero -->
      <header class="pro-hero">
        <div class="pro-hero-identity">
          <div class="pro-avatar-wrap profile-gradient-border">
            <div class="relative w-full h-full rounded-full overflow-hidden z-10">
              <img src="/profile.webp" alt="Kris Escobar" class="w-full h-full rounded-full object-cover" loading="eager" />
            </div>
          </div>
          <div>
            <div class="pro-hero-badge">{t('landing.pro.tag')}</div>
            <h1 class="pro-hero-name font-uni-neue italic">Kris Escobar</h1>
          </div>
        </div>
        <p class="pro-hero-bio">{t('pro.bio')}</p>

        <!-- Current role card -->
        <div class="role-card">
          <div class="role-left">
            <div class="role-current-label">{t('pro.current')}</div>
            <div class="role-company">{t('pro.company')}</div>
            <div class="role-title">{t('pro.role')}</div>
            <div class="role-since">{roleSinceLine}</div>
          </div>
          <div class="role-badge">{t('pro.targeting')}</div>
        </div>

        <!-- CTA links -->
        <div class="hero-links">
          <a href="https://github.com/KrisEnigma" target="_blank" rel="noopener noreferrer" class="hero-btn hero-btn-outline" data-track="cta_click" data-label="pro_github">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            {t('pro.github.label')}
          </a>
          <a href="https://linkedin.com/in/krisescobar" target="_blank" rel="noopener noreferrer" class="hero-btn hero-btn-outline" data-track="cta_click" data-label="pro_linkedin">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            {t('pro.linkedin.label')}
          </a>
          <a href="/cv.pdf" download class="hero-btn hero-btn-primary" data-track="cta_click" data-label="pro_cv_download">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            {t('pro.cv.label')}
          </a>
          <a href={`${prefix}/contact`} class="hero-btn hero-btn-ghost" data-track="cta_click" data-label="pro_contact_cta">{t('pro.contact.label')}</a>
        </div>
      </header>

      <!-- Experience -->
      <section class="page-section">
        <h2 class="page-section-label">{t('pro.sections.experience')}</h2>
        <div class="exp-list">
          {experience.map(e => (
            <div class="exp-item">
              <div class="exp-header">
                <div class="exp-company">{e.company}</div>
                <div class="exp-period">{e.period}</div>
              </div>
              <div class="exp-role">{e.role}</div>
              <p class="exp-desc">{e.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Projects -->
      <section class="page-section">
        <h2 class="page-section-label">{t('pro.sections.projects')}</h2>
        <div class="projects-grid">
          {projects.map(p => (
            <div class={`project-card project-card-${p.accent}`}>
              <div class="project-top">
                <div class="project-emoji">{p.emoji}</div>
                <div class="project-meta">
                  <div class="project-name">{p.name}</div>
                  {p.years && <div class="project-years">{p.years} {t('pro.years.active')}</div>}
                </div>
                {p.url && (
                  <a href={p.url} target="_blank" rel="noopener noreferrer" class="project-link" aria-label={`${visitLabel} ${p.name}`}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                )}
              </div>
              <p class="project-desc">{p.desc}</p>
              <div class="project-tech">
                {p.tech.map(item => <span class="tech-badge">{item}</span>)}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Stack -->
      <section class="page-section">
        <h2 class="page-section-label">{t('pro.sections.stack')}</h2>
        <div class="stack-groups">
          {stack.map(s => (
            <div class="stack-group">
              <div class="stack-group-label">{s.label}</div>
              <div class="stack-pills">
                {s.items.split(' · ').map(item => <span class="stack-pill">{item}</span>)}
              </div>
            </div>
          ))}
        </div>
      </section>

      <a href={`${prefix}/creator`} class="page-crosslink">
        <span>{crosslinkText}</span>
        <span class="crosslink-arrow">{crosslinkArrow}</span>
      </a>
    </div>

    <!-- Footer -->
    <footer class="pro-footer">
      <div class="pro-footer-inner">
        <div class="pro-footer-brand">
          <div class="pro-footer-name">Kris Escobar</div>
          <p class="pro-footer-tagline">{t('pro.tagline')}</p>
        </div>
        <div class="footer-links-row">
          <a href={`${prefix}/`} class="footer-link">{t('nav.home')}</a>
          <a href={`${prefix}/creator`} class="footer-link">{t('nav.creator')}</a>
          <a href={`${prefix}/contact`} class="footer-link">{t('nav.contact')}</a>
          <a href="https://github.com/KrisEnigma" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
          <a href="https://linkedin.com/in/krisescobar" target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn</a>
        </div>
        <p class="footer-copy">© <span id="currentYear"></span> KrisEnigma. {t('footer.rights')}</p>
        <p class="footer-powered">{t('footer.powered')}</p>
      </div>
    </footer>
  </div>
</Layout>

<script is:inline>document.getElementById('currentYear').textContent = new Date().getFullYear();</script>

<style>
  .pro-page { min-height: 100vh; display: flex; flex-direction: column; --page-accent: #9b7fee; }

  .back-nav { position: fixed; top: 16px; left: 16px; z-index: 40; display: flex; align-items: center; gap: 8px; }
  .back-link { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.3); text-decoration: none; display: flex; align-items: center; gap: 5px; padding: 4px 10px; border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; backdrop-filter: blur(4px); background: rgba(0,0,0,0.2); transition: color 0.2s, border-color 0.2s; }
  .back-link:hover { color: #9b7fee; border-color: rgba(122,83,221,0.25); }
  .nav-contact-pill:hover { color: #00e1af; border-color: rgba(0,225,175,0.25); }

  .pro-inner { max-width: 720px; margin: 0 auto; padding: 80px 24px 48px; width: 100%; flex: 1; }

  /* Hero */
  .pro-hero { margin-bottom: 56px; }
  .pro-hero-identity { display: flex; align-items: center; gap: 20px; margin-bottom: 24px; flex-wrap: wrap; }
  .pro-avatar-wrap { width: 64px; height: 64px; border-radius: 50%; flex-shrink: 0; position: relative; }
  .pro-avatar-wrap::before { inset: -3px; padding: 3px; }
  .pro-hero-badge { display: inline-flex; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; padding: 4px 14px; border-radius: 20px; background: rgba(122,83,221,0.08); color: #9b7fee; border: 1px solid rgba(122,83,221,0.2); margin-bottom: 8px; font-weight: 700; font-family: 'Uni Neue', sans-serif; font-style: italic; }
  .pro-hero-name { font-size: clamp(24px, 4.5vw, 42px); font-weight: 700; color: #ffffff; margin: 0; line-height: 1.15; }
  .accent-purple { color: #9b7fee; }
  .pro-hero-bio { font-size: 14px; color: rgba(255,255,255,0.5); line-height: 1.8; max-width: 640px; margin-bottom: 28px; }

  /* Role card */
  .role-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-left: 2px solid rgba(0,225,175,0.35); border-radius: 12px; padding: 20px 24px; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 28px; }
  .role-current-label { font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(0,225,175,0.5); margin-bottom: 6px; }
  .role-company { font-size: 13px; font-weight: 700; color: #00e1af; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 4px; }
  .role-title { font-size: 16px; font-weight: 600; color: #ffffff; margin-bottom: 4px; }
  .role-since { font-size: 12px; color: rgba(255,255,255,0.35); }
  .role-badge { font-size: 11px; color: #9b7fee; background: rgba(122,83,221,0.08); border: 1px solid rgba(122,83,221,0.2); padding: 4px 12px; border-radius: 20px; white-space: nowrap; align-self: center; }

  /* CTA links */
  .hero-links { display: flex; flex-wrap: wrap; gap: 10px; }
  .hero-btn { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 700; padding: 9px 18px; border-radius: 8px; text-decoration: none; transition: opacity 0.2s, transform 0.2s; letter-spacing: 0.03em; }
  .hero-btn:hover { opacity: 0.85; transform: translateY(-1px); }
  .hero-btn-outline { color: rgba(255,255,255,0.6); border: 1px solid rgba(255,255,255,0.12); background: transparent; }
  .hero-btn-outline:hover { color: #ffffff; border-color: rgba(255,255,255,0.25); }
  .hero-btn-primary { color: #00e1af; border: 1px solid rgba(0,225,175,0.3); background: rgba(0,225,175,0.08); }
  .hero-btn-primary:hover { box-shadow: 0 0 20px rgba(0,225,175,0.16), 0 0 6px rgba(0,225,175,0.08); }
  .hero-btn-ghost { color: rgba(255,255,255,0.4); border: 1px solid rgba(255,255,255,0.08); background: transparent; }

  /* Projects */
  .projects-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 600px) { .projects-grid { grid-template-columns: 1fr; } }
  .project-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 12px; padding: 20px; transition: border-color 0.2s, background 0.2s, transform 0.2s; }
  .project-card:hover { background: rgba(255,255,255,0.05); transform: translateY(-2px); }
  .project-card-teal { border-color: rgba(0,225,175,0.1); }
  .project-card-teal:hover { border-color: rgba(0,225,175,0.2); }
  .project-card-purple { border-color: rgba(122,83,221,0.1); }
  .project-card-purple:hover { border-color: rgba(122,83,221,0.2); }
  .project-top { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 10px; }
  .project-emoji { font-size: 22px; line-height: 1; flex-shrink: 0; }
  .project-meta { flex: 1; }
  .project-name { font-size: 15px; font-weight: 700; color: #ffffff; margin-bottom: 2px; font-family: 'Uni Neue', sans-serif; font-style: italic; }
  .project-years { font-size: 11px; color: rgba(255,255,255,0.3); }
