---
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/utils";
import "../../styles/landing.css";
import Logo from "../Logo.astro";

interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'en' ? '/en' : '';
---

<Layout
  title="KrisEnigma"
  description={lang === 'en'
    ? "Musician, Gamer and Content Creator. AI Solutions and Full-Stack Developer"
    : "Músico, Gamer y Creador de Contenido. AI Solutions y Full-Stack Developer"}
  noBackground={true}
>
  <div class="ke-landing">
    <div class="ke-top-nav">
      <a href={`${prefix}/contact`} class="ke-top-link">{t('nav.contact')}</a>
    </div>

    <div class="ke-split">
      <!-- Panel creador -->
      <a href={`${prefix}/creator`} class="ke-panel ke-panel-creator" aria-label={t('landing.creator.cta')} data-track="cta_click" data-label="panel_creator">
        <span class="ke-tag ke-tag-creator">{t('landing.creator.tag')}</span>

        <div class="ke-name ke-name-creator"><Logo size="text-5xl lg:text-6xl" /></div>
        <div class="ke-subtitle">{t('landing.creator.subtitle')}</div>

        <p class="ke-meta ke-meta-creator">
          {lang === 'en'
            ? 'YouTube, Spotify, Tercer Ojo, Psycho Crusher, 26K+ followers'
            : 'YouTube, Spotify, Tercer Ojo, Psycho Crusher, 26K+ seguidores'}
        </p>

        <span class="ke-cta ke-cta-creator">{t('landing.creator.cta')}</span>
      </a>

      <!-- Panel profesional -->
      <a href={`${prefix}/pro`} class="ke-panel ke-panel-pro" aria-label={t('landing.pro.cta')} data-track="cta_click" data-label="panel_pro">
        <span class="ke-tag ke-tag-pro">{t('landing.pro.tag')}</span>

        <div class="ke-name ke-name-pro"><span class="ke-name-accent">Kris</span> Escobar</div>
        <div class="ke-subtitle">{t('landing.pro.subtitle')}</div>

        <p class="ke-meta ke-meta-pro">
          ElevenLabs, Node, React, Next.js, Cloudflare, Firebase, RAG, Ollama, Solutions Engineering
        </p>

        <span class="ke-cta ke-cta-pro">{t('landing.pro.cta')}</span>
      </a>
    </div>

    <footer class="ke-footer">
      <div class="ke-footer-inner">
        <div class="ke-footer-brand">
          <Logo />
        </div>
        <div class="ke-footer-links">
          <a href={`${prefix}/creator`} class="ke-footer-link">{t('nav.creator')}</a>
          <a href={`${prefix}/pro`} class="ke-footer-link">{t('nav.pro')}</a>
          <a href={`${prefix}/contact`} class="ke-footer-link">{t('nav.contact')}</a>
        </div>
        <p class="ke-footer-copy">© <span id="currentYear"></span> KrisEnigma. {t('footer.rights')}</p>
      </div>
    </footer>
  </div>
</Layout>

<script is:inline>document.getElementById('currentYear').textContent = new Date().getFullYear();</script>
