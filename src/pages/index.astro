  <script>
    // Actualizar año currentYear en el footer
    document.addEventListener("DOMContentLoaded", function () {
      const currentYearElement = document.getElementById("currentYear");
      if (currentYearElement) {
        currentYearElement.textContent = new Date().getFullYear().toString();
      } // YouTube Lazy Loading
      const youtubeContainer = document.getElementById("youtube-container");
      const youtubeThumbnail = document.getElementById("youtube-thumbnail");
      const youtubeIframeContainer = document.getElementById(
        "youtube-iframe-container"
      );

      let youtubeLoaded = false;

      function loadYouTubeVideo() {
        if (youtubeLoaded) return;

        youtubeLoaded = true;

        // Crear iframe sin autoplay
        const iframe = document.createElement("iframe");
        iframe.src = "https://www.youtube.com/embed/v-qHDk9bTZg?rel=0";
        iframe.title = "YouTube video player";
        iframe.allow =
          "accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        iframe.className = "w-full h-full rounded-xl border-0";
        iframe.style.border = "0";

        // Agregar iframe al contenedor primero
        if (youtubeIframeContainer) {
          youtubeIframeContainer.appendChild(iframe);
        }

        // Función para mostrar el video
        const showVideo = () => {
          if (youtubeThumbnail) {
            youtubeThumbnail.style.display = "none";
          }
          if (youtubeIframeContainer) {
            youtubeIframeContainer.classList.remove("hidden");
          }
        };

        // Timeout de respaldo (1 segundo)
        const fallbackTimeout = setTimeout(showVideo, 1000);

        // Cuando el iframe termine de cargar
        iframe.onload = function () {
          clearTimeout(fallbackTimeout);
          showVideo();
        };
      }

      // Click handler para cargar el video manualmente
      if (youtubeContainer) {
        youtubeContainer.addEventListener("click", loadYouTubeVideo);
      }

      // Intersection Observer para carga automática cuando esté visible
      if (youtubeContainer && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && entry.intersectionRatio > 0.3) {
                // Carga automática cuando el 30% del video esté visible
                loadYouTubeVideo();
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.3,
            rootMargin: "100px",
          }
        );

        observer.observe(youtubeContainer);
      }
    });
  </script>
