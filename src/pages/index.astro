---
import Layout from '../layouts/Layout.astro';
import SocialButton from '../components/SocialButton.astro';
import LinkCard from '../components/LinkCard.astro';
import ContactSection from '../components/ContactSection.astro';
import profileWebp from '../assets/profile.webp';
import kriswaveWebp from '../assets/kriswave.webp';
---

<Layout title="KrisEnigma - Músico. Gamer. Creador de Contenido.">  <div class="flex min-h-screen flex-col">    <!-- Hero Section con diseño moderno -->
    <section class="relative pt-8 pb-6">
      <div class="container mx-auto px-6 lg:max-w-4xl">        <!-- Profile Section con glassmorphism -->
        <div class="text-center">          <!-- Imagen de perfil con border animado mejorado -->
          <div class="relative inline-block mb-4 w-36 h-36 lg:w-40 lg:h-40 profile-gradient-border">
            <!-- Contenedor de la imagen -->            <div class="relative w-full h-full rounded-full overflow-hidden z-10">
              <img
                class="w-full h-full rounded-full object-cover transition-transform duration-300 hover:scale-110"
                src={profileWebp.src}
                alt="KrisEnigma - Foto de perfil"
                loading="eager"
              />
            </div>
          </div>
            <!-- Nombre con tipografía mejorada -->
          <div class="mb-4 flex items-center justify-center">            <h1 class="text-5xl lg:text-6xl font-aerovias mr-2">
              <span class="logo-kris">Kris</span><span class="logo-enigma">Enigma</span>
            </h1>
              <!-- Icono verificado mejorado -->
            <div class="mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-7 h-7 text-theme-primary">
                <path fill="currentColor" d="M22.51 13.76a3 3 0 0 1 0-3.52l.76-1.05a1 1 0 0 0 .14-.9 1.02 1.02 0 0 0-.64-.64l-1.23-.4a2.99 2.99 0 0 1-2.07-2.85V3.1a1 1 0 0 0-1.31-.95l-1.24.4a3 3 0 0 1-3.35-1.09L12.81.41a1.036 1.036 0 0 0-1.62 0l-.76 1.05a3 3 0 0 1-3.35 1.09l-1.24-.4a1 1 0 0 0-1.31.95v1.3a2.99 2.99 0 0 1-2.07 2.85l-1.23.4a1.02 1.02 0 0 0-.64.64 1 1 0 0 0 .14.9l.76 1.05a3 3 0 0 1 0 3.52l-.76 1.05a1 1 0 0 0-.14.9 1.02 1.02 0 0 0 .64.64l1.23.4a2.99 2.99 0 0 1 2.07 2.85v1.3a1 1 0 0 0 1.31.95l1.23-.4a2.99 2.99 0 0 1 3.36 1.09l.76 1.05a1.005 1.005 0 0 0 1.62 0l.76-1.05a3 3 0 0 1 3.36-1.09l1.23.4a1 1 0 0 0 1.31-.95v-1.3a2.99 2.99 0 0 1 2.07-2.85l1.23-.4a1.02 1.02 0 0 0 .64-.64 1 1 0 0 0-.14-.9Zm-5.8-3.053-5 5a1 1 0 0 1-1.414 0l-3-3a1 1 0 1 1 1.414-1.414L11 13.586l4.293-4.293a1 1 0 0 1 1.414 1.414Z"/>
              </svg>
            </div>
          </div>            <!-- Descripción con tipografía mejorada -->
          <p class="text-lg lg:text-xl text-white/90 italic max-w-2xl mx-auto mb-6">
            I am a meat popsicle • Músico <span class="not-italic">🎸</span> • Gamer <span class="not-italic">🎮</span> • Creador de Contenido <span class="not-italic">📷</span>
          </p>
        </div>
        
        <!-- Redes sociales con diseño flex moderno -->
        <div class="flex flex-wrap justify-center items-center gap-3 sm:gap-2">
          <SocialButton href="mailto:contacto@krisenigma.com" ariaLabel="Mail">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/>
              <path d="M3 7l9 6l9 -6"/>
            </svg>
          </SocialButton>
          <SocialButton href="https://youtube.com/KrisEnigma" ariaLabel="Youtube" >
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="5" width="18" height="14" rx="4"/>
              <path d="M10 9l5 3l-5 3z"/>
            </svg>
          </SocialButton>
          <SocialButton href="https://tiktok.com/@KrisEnigma" ariaLabel="TikTok" >
