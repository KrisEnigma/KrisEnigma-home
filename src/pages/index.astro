              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/>
            </svg>
          </SocialButton>
          <SocialButton href="https://facebook.com/KrisEnigma" ariaLabel="Facebook" >
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"/>
            </svg>
          </SocialButton>
          <SocialButton href="https://dsc.gg/krisenigma" ariaLabel="Discord" >
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="9" cy="12" r="1"/>
              <circle cx="15" cy="12" r="1"/>
              <path d="M7.5 7.5c3.5 -1 5.5 -1 9 0"/>
              <path d="M7 16.5c3.5 1 6.5 1 10 0"/>
              <path d="M15.5 17c0 1 1.5 3 2 3c1.5 0 2.833 -1.667 3.5 -3c.667 -1.667 .5 -5.833 -1.5 -11.5c-1.457 -1.015 -3 -1.34 -4.5 -1.5l-1 2.5"/>
              <path d="M8.5 17c0 1 -1.356 3 -1.832 3c-1.429 0 -2.698 -1.667 -3.333 -3c-.635 -1.667 -.476 -5.833 1.428 -11.5c1.388 -1.015 2.782 -1.34 4.237 -1.5l1 2.5"/>
            </svg>
          </SocialButton>
          <SocialButton href="https://twitch.tv/KrisEnigma" ariaLabel="Twitch" >
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 5v11a1 1 0 0 0 1 1h2v4l4 -4h5.584c.266 0 .52 -.105 .707 -.293l2.415 -2.414c.187 -.188 .293 -.442 .293 -.708v-8.585a1 1 0 0 0 -1 -1h-14a1 1 0 0 0 -1 1z"/>
              <line x1="16" y1="8" x2="16" y2="12"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
            </svg>
          </SocialButton>
          <SocialButton href="https://open.spotify.com/artist/58QiArKYlCuEDMRBimZ48G" ariaLabel="Spotify" >
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="9"/>
              <path d="M8 11.973c2.5 -1.473 5.5 -.973 7.5 .527"/>
              <path d="M9 15c1.5 -1 4 -1 5 .5"/>
              <path d="M7 9c2 -1 6 -2 10 .5"/>
            </svg>
          </SocialButton>
          <SocialButton href="https://steamcommunity.com/id/KrisEnigma/" ariaLabel="Steam" >
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16.5 5a4.5 4.5 0 1 1 -.653 8.953l-4.347 3.009l0 .038a3 3 0 0 1 -2.824 3l-.176 0a3 3 0 0 1 -2.94 -2.402l-2.56 -1.098v-3.5l3.51 1.755a2.989 2.989 0 0 1 2.834 -.635l2.727 -3.818a4.5 4.5 0 0 1 4.429 -5.302z"/>
              <circle cx="16.5" cy="9.5" r="1" fill="currentColor"/>
            </svg>
          </SocialButton>
        </div>
      </div>
    </section>      <main>        <section class="sm:mx-auto w-full sm:max-w-lg md:max-w-xl xl:max-w-2xl px-4 mt-6">
          <div class="mt-3">
            <LinkCard onClick="openContact" image="https://media.esponsor.com/media/public/images/5xn1v531yq/krisenigma-link-contacto-1703285776.webp" title="Contacto" loading="eager" />
          </div>
          
          <div class="mt-3">
            <LinkCard href="/mediakit.pdf" image="https://www.svgrepo.com/show/255818/pdf.svg" title="Media Kit" loading="eager" />
          </div>        </section>        <section class="sm:mx-auto w-full sm:max-w-lg md:max-w-xl xl:max-w-2xl px-4 mt-10">          <div class="text-center mb-6 relative">
            <h2 class="text-2xl md:text-3xl italic section-title-enhanced">
              Biografía
            </h2>          </div>
            <div class="group">
              <div class="glass-element relative rounded-2xl glass-bg border border-white/30 overflow-hidden">
                <!-- Image container -->
                <div class="relative p-4">
                  <div class="relative overflow-hidden rounded-xl cursor-pointer">
                    <img 
                      src={kriswaveWebp.src}
                      loading="eager" 
                      class="w-full h-80 object-cover transition-transform duration-500 ease-out hover:scale-105" 
                      alt="KrisEnigma Biografía"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent pointer-events-none"></div>
                  </div>
                </div>
                  <!-- Content -->
                <div class="relative z-10 px-6 pb-6">
                  <article class="max-w-none">                    <div class="space-y-4 text-left leading-relaxed">
                      <p class="text-base text-white">Hola! Soy <strong class="text-theme-primary italic">KrisEnigma</strong>, un gamer y músico que vive y respira videojuegos y rock. Desde mi infancia, con un joystick en una mano y una guitarra en la otra, he vivido la evolución de los videojuegos, desde la época del Atari hasta la generación actual.</p>
                      
                      <p class="text-base text-white">Creador del enigmático juego <strong class="text-theme-primary italic">Tercer Ojo</strong>, el año 2006 me puse la meta de desarrollar contenido interactivo e interesante, creando una comunidad dedicada y activa en su auge.</p>
                      
                      <p class="text-base text-white">Con <strong class="text-theme-primary italic">Psycho Crusher</strong>, mi proyecto de rock de videojuegos iniciado en el 2010, he recorrido todo Chile llevando temazos de juegos clásicos y modernos con un toque de guitarra eléctrica. Si has estado en eventos como Festigame o Minami Convention, probablemente me has escuchado. Tengo 2 discos que puedes encontrar en todas las plataformas musicales.</p>
                      
                      <p class="text-base text-white">He trabajado en múltiples facetas de la industria de los videojuegos, desde guionista y editor hasta presentador en proyectos y medios creados por fans y canales de cable como <strong class="text-theme-primary italic">ControlVG</strong> y <strong class="text-theme-primary italic">Nexoplay</strong>. Hasta me he codeado con grandes de la industria en eventos internacionales como la E3, donde he entrevistado a personalidades como Reggie Fils-Aimé de Nintendo of America, Ed Boon de NetherRealm Studios y muchos más.</p>
                      
                      <p class="text-base text-white">En las redes, me encuentras en <strong class="text-theme-primary italic">Instagram</strong> y <strong class="text-theme-primary italic">TikTok</strong> compartiendo datos rápidos y curiosidades sobre juegos, perfecto para tus dosis rápidas e interesantes de gaming. En <strong class="text-theme-primary italic">YouTube</strong>, me pongo serio (pero no tanto) analizando juegos y la industria con un enfoque crítico y artístico, creando contenido en formato largo que me deja profundizar más. También hago streams de vivo de variados videojuegos que me parecen interesantes y comento los eventos más importantes del año, como <strong class="text-theme-primary italic">The Game Awards</strong>.</p>
                      
                      <p class="text-base text-white">Me esfuerzo por ser una voz sólida y con mucha credibilidad en la comunidad de videojuegos, proporcionando una mezcla equilibrada de entretenimiento, educación y análisis crítico. Mi objetivo es mantener a los entusiastas de los videojuegos informados y comprometidos, mientras sigo explorando y compartiendo mi pasión por los videojuegos y la música.</p>
                      
                      <p class="text-base text-white">Así que, si buscas alguien que combine juegos, música y una buena conversación, <strong class="text-theme-primary italic">aquí estoy!</strong></p>
                    </div>
                  </article>
                </div>              </div>
            </div>
          </section>        <section class="sm:mx-auto w-full sm:max-w-lg md:max-w-xl xl:max-w-2xl px-4 mt-10">          <div class="text-center mb-6 relative">
            <h2 class="text-2xl md:text-3xl italic section-title-enhanced">
              Redes de Contenido
            </h2>
          </div>
          <div class="grid gap-4">
            <div class="">
              <LinkCard href="https://www.youtube.com/KrisEnigma" image="https://media.esponsor.com/media/public/images/q6n7lv56yv/link-YouTube-1659670393.webp" title="YouTube" loading="lazy" />
            </div>
            <div class=" ">
              <LinkCard href="https://www.instagram.com/KrisEnigma" image="https://media.esponsor.com/media/public/images/1kyqw280y5/link-Instagram-1659670431.webp" title="Instagram" loading="lazy" />
            </div>
            <div class=" ">
              <LinkCard href="https://www.tiktok.com/@krisenigma" image="https://media.esponsor.com/media/public/images/0myrpz67y8/link-TikTok-1659670444.webp" title="TikTok" loading="lazy" />
            </div>
            <div class=" ">
              <LinkCard href="https://www.twitch.tv/KrisEnigma" image="https://media.esponsor.com/media/public/images/5vyw47020n/conversions/php57fFTP-web.webp" title="Twitch" loading="lazy" />
            </div>
          </div>        </section>

        <section class="sm:mx-auto w-full sm:max-w-lg md:max-w-xl xl:max-w-2xl px-4 mt-10">
          <div class="relative w-full aspect-video">            <iframe
              src="https://www.youtube.com/embed/v-qHDk9bTZg?si=ZfJOxtzAtDVioFHp" 
              title="YouTube video player" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
              class="absolute inset-0 w-full h-full rounded-xl border-0"
              loading="lazy"
            ></iframe>
          </div>        </section>        <section class="sm:mx-auto w-full sm:max-w-lg md:max-w-xl xl:max-w-2xl px-4 mt-10">          <div class="text-center mb-6 relative">
            <h2 class="text-2xl md:text-3xl italic section-title-enhanced">
              Proyectos
            </h2>
          </div>
          <div class="grid gap-4">
            <div class="">
              <LinkCard href="https://tercerojo.krisenigma.com" image="https://media.esponsor.com/media/public/images/0mnr65w7n8/krisenigma-link-tercer-ojo-el-juego-por-krisenigma-1703286170.webp" title="Tercer Ojo - El Juego" loading="lazy" />
            </div>
            <div >
              <LinkCard href="http://psycho-crusher.com/" image="https://media.esponsor.com/media/public/images/1knq86v0y5/krisenigma-link-psycho-crusher-1703285875.webp" title="Psycho Crusher" loading="lazy" />
            </div>            <div class="">
              <a href="https://krisenigma.com/gamelist" target="_blank" rel="noopener noreferrer" class="group relative grid grid-cols-9 items-center rounded-xl w-full glass-bg border border-white/20 text-white px-4 min-h-[3rem] hover:border-white/30 transform hover:scale-[1.01] link-item overflow-hidden transition-all duration-200 ease-out">
                <div class="absolute inset-0 bg-gradient-to-r from-theme-primary/5 to-theme-accent/5 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
                <div class="h-8 w-8 col-span-1 justify-self-center relative z-10 flex items-center justify-center text-2xl">
                  🎮
                </div>
                <div class="col-span-8 ml-2">
                  <div class="font-medium">GameList</div>
                  <div class="text-sm text-white/70">Lista de juegos completados por KrisEnigma</div>
                </div>
              </a>
            </div>
            <div class="">
              <a href="https://github.com/KrisEnigma/GameSalad" target="_blank" rel="noopener noreferrer" class="group relative grid grid-cols-9 items-center rounded-xl w-full glass-bg border border-white/20 text-white px-4 min-h-[3rem] hover:border-white/30 transform hover:scale-[1.01] link-item overflow-hidden transition-all duration-200 ease-out">
                <div class="absolute inset-0 bg-gradient-to-r from-theme-primary/5 to-theme-accent/5 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
                <div class="h-8 w-8 col-span-1 justify-self-center relative z-10 flex items-center justify-center text-2xl">
                  🎯
                </div>
                <div class="col-span-8 ml-2">
                  <div class="font-medium">GameSalad</div>
                  <div class="text-sm text-white/70">Juego de palabras inspirado en el clásico Lingo. Próximamente online.</div>
                </div>
              </a>
            </div>
          </div>        </section>
      </main>
    </div>    <div class="pb-8"></div> <!-- Reduced bottom padding -->
  </div>
  
  <!-- Modal de contacto -->
  <ContactSection />
</Layout>