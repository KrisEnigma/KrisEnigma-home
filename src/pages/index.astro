<script>
  // Funcionalidad del botón "Volver Arriba"
  document.addEventListener("DOMContentLoaded", function () {
    const scrollToTopBtn = document.getElementById("scrollToTop");

    if (scrollToTopBtn) {
      // Mostrar/ocultar botón basado en scroll
      window.addEventListener("scroll", function () {
        if (window.pageYOffset > 300) {
          scrollToTopBtn.classList.remove("opacity-0", "pointer-events-none");
        } else {
          scrollToTopBtn.classList.add("opacity-0", "pointer-events-none");
        }
      });

      // Hacer scroll suave al inicio al hacer clic
      scrollToTopBtn.addEventListener("click", function () {
        window.scrollTo({
          top: 0,
          behavior: "smooth",
        });
      });
    }
  });
</script>

<!-- Atajos de teclado y mejoras de accesibilidad -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Actualizar año actual
    const currentYearElement = document.getElementById("currentYear");
    if (currentYearElement) {
      currentYearElement.textContent = new Date().getFullYear().toString();
    }
    // Atajos de teclado
    document.addEventListener("keydown", (e) => {
      // Alt + C para abrir contacto
      if (e.altKey && e.key === "c") {
        e.preventDefault();
        if (typeof (window as any).openContact === "function") {
          (window as any).openContact();
        }
      }

      // Alt + T para ir al top (scroll to top)
      if (e.altKey && e.key === "t") {
        e.preventDefault();
        window.scrollTo({
          top: 0,
          behavior: "smooth",
        });
      }

      // Escape para cerrar cualquier modal abierto
      if (e.key === "Escape") {
        // Ya está manejado por los modales individuales
      }
    });

    // Mejorar el focus en elementos interactivos
    const interactiveElements = document.querySelectorAll(
      "button, a, [tabindex]"
    );
    interactiveElements.forEach((element) => {
      element.addEventListener("focus", (e) => {
        const target = e.target as HTMLElement;
        target.style.outline = "2px solid #00e1af";
        target.style.outlineOffset = "2px";
      });
      element.addEventListener("blur", (e) => {
        const target = e.target as HTMLElement;
        target.style.outline = "";
        target.style.outlineOffset = "";
      });
    });
  });
  // Font selector functionality
  const changeBioFont = (fontName: string) => {
    const bioContent = document.getElementById("bioContent");
    const buttons = document.querySelectorAll(".font-selector-btn");

    if (bioContent) {
      // Remove all font classes
      bioContent.classList.remove(
        "font-poppins",
        "font-space-grotesk",
        "font-jetbrains",
        "font-orbitron",
        "font-outfit",
        "font-rajdhani",
        "font-electrolize",
        "font-exo",
        "font-michroma",
        "font-chakra",
        "font-play",
        "font-saira",
        "font-uni-neue",
        "font-oxanium",
        "font-iceberg",
        "font-audiowide",
        "font-syncopate",
        "font-share-tech",
        "font-share-tech-mono",
        "font-aldrich",
        "font-turret",
        "font-titillium",
        "font-nova-mono",
        "font-comfortaa",
        "font-maven",
        "font-advent",
        "font-bai",
        "font-quantico",
        "font-gruppo",
        "font-sarpanch",
        "font-stalinist",
        "font-geo",
        "font-faster",
        "font-monofett"
      );

      // Add new font class based on font name
      const fontMap: { [key: string]: string } = {
        Poppins: "font-poppins",
        "Space Grotesk": "font-space-grotesk",
        "JetBrains Mono": "font-jetbrains",
        Orbitron: "font-orbitron",
        Outfit: "font-outfit",
        Rajdhani: "font-rajdhani",
        Electrolize: "font-electrolize",
        "Exo 2": "font-exo",
        Michroma: "font-michroma",
        "Chakra Petch": "font-chakra",
        Play: "font-play",
        Saira: "font-saira",
        "Uni Neue": "font-uni-neue",
        Oxanium: "font-oxanium",
        Iceberg: "font-iceberg",
        Audiowide: "font-audiowide",
        Syncopate: "font-syncopate",
        "Share Tech": "font-share-tech",
        "Share Tech Mono": "font-share-tech-mono",
        Aldrich: "font-aldrich",
        "Turret Road": "font-turret",
        "Titillium Web": "font-titillium",
        "Nova Mono": "font-nova-mono",
        Comfortaa: "font-comfortaa",
        "Maven Pro": "font-maven",
        "Advent Pro": "font-advent",
        "Bai Jamjuree": "font-bai",
        Quantico: "font-quantico",
        Gruppo: "font-gruppo",
        Sarpanch: "font-sarpanch",
        "Stalinist One": "font-stalinist",
        Geo: "font-geo",
        "Faster One": "font-faster",
        Monofett: "font-monofett",
      };

      const fontClass = fontMap[fontName];
      if (fontClass) {
        bioContent.classList.add(fontClass);
      }
    }

    // Update button states
    buttons.forEach((btn) => btn.classList.remove("active"));
    const activeBtn = document.querySelector(`[data-font="${fontName}"]`);
    if (activeBtn) activeBtn.classList.add("active");
  };

  // Make function global
  (window as any).changeBioFont = changeBioFont;
</script>

<style>
  .font-selector-btn {
    @apply px-2 py-1 text-xs rounded-md bg-white/10 hover:bg-white/20 text-white/70 hover:text-white transition-all duration-200 border border-white/10;
  }

  .font-selector-btn.active {
    @apply bg-theme-primary/20 text-theme-primary border-theme-primary/30;
  }
</style>
