# Configuración de entorno para KrisEnigma Website
# Copiar este archivo como .env y rellenar con tus valores reales
# NUNCA subas el archivo .env real a git

# API Keys
# Resend API Key para el formulario de contacto
# Obtén tu clave en: https://resend.com/api-keys
RESEND_API_KEY=tu_clave_aqui

# Analytics
# Google Analytics 4 ID (opcional)
PUBLIC_GTAG_ID=G-XXXXXXXXXX

# Site Configuration
SITE_URL=https://krisenigma.com
PUBLIC_SITE_NAME=KrisEnigma

# Contact Configuration
CONTACT_EMAIL=contacto@krisenigma.com

# Security
ENABLE_CSP=true
